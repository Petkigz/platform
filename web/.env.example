# Copy to .env.local. Never commit .env.local.
#
# Both values come from Supabase → Project Settings → API. The anon key is
# safe to ship to the browser: row level security is what actually protects
# the data, and every table in this schema has it enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set only when running `next build` without a live project. It skips the
# env check so the build can be verified in CI. Never set this in production.
NEXT_PUBLIC_ALLOW_MISSING_SUPABASE=1

# Required by the payment webhook only. Never prefix this with NEXT_PUBLIC_ —
# it bypasses every row level security policy in the schema and must not reach
# a browser bundle. Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which registered payment adapter is live. Leave unset until a provider is
# chosen (DECISIONS.md P12); checkout then reports that payments are not
# configured rather than pretending.
PAYMENT_PROVIDER=

# ---------------------------------------------------------------------------
# Payment providers
#
# More than one provider can be live at once. A provider is offered on the
# checkout page as soon as its credentials are present — no code change and no
# redeploy, which is how a provider that is not built yet gets switched on.
# Leave a block empty and that provider is simply not offered.
#
# Every credential here is server-only. None of these may be prefixed
# NEXT_PUBLIC_: they authenticate the platform to the provider, and anything
# exposed to the browser lets a caller initiate payments as the merchant.
#
# PAYMENT_PROVIDER is optional. It pins a single provider for deployments that
# want one; with it unset, the first available provider is the default and the
# payer can choose between the rest.
# ---------------------------------------------------------------------------

# Optional: pin one provider (mtn_momo | airtel_money)
PAYMENT_PROVIDER=

# --- MTN MoMo (Collections) -------------------------------------------------
# Sandbox credentials are self-provisioned at https://momodeveloper.mtn.com.
# Production base URL and X-Target-Environment are market-specific — for
# Uganda the environment is mtnuganda; confirm the host with MTN.
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# Must be publicly reachable over HTTPS. Set this to the per-provider route:
#   https://your-domain/api/payments/webhook/mtn_momo
MTN_MOMO_CALLBACK_URL=

# Refunds go out through MTN's Disbursements product, which is a separate
# subscription with its own credentials. Without these, refunding an MTN
# payment is refused rather than silently skipped.
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=

# --- Airtel Money ----------------------------------------------------------
# Sandbox is openapiuat.airtel.africa; production is openapi.airtel.africa.
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX
# The refund path differs between markets and API versions. Confirm it in
# sandbox before going live; the default is the most widely documented shape.
AIRTEL_REFUND_PATH=/merchant/v1/payments/refund/

# Cloudflare R2, chosen for media masters and delivery on 2026-10-20 (D8,
# costed at docs/decisions/media-storage-costing.md). Server-side only: the
# secret signs uploads, so it must never carry a NEXT_PUBLIC_ prefix or reach a
# browser bundle. Leave unset until the bucket and API token exist; /api/media
# then reports that storage is not configured rather than pretending.
# R2 → Account ID, and an API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional. These defaults must match what register_media_upload() derives for
# backend 'r2' (supabase/migrations/20261107000100_media_asset_writer.sql);
# /api/media refuses rather than signs when the two disagree.
# R2_MASTERS_BUCKET=ayahspring-masters
# R2_RENDITIONS_BUCKET=ayahspring-renditions
