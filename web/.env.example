# Copy to .env.local. Never commit .env.local.
#
# Both values come from Supabase → Project Settings → API. The anon key is
# safe to ship to the browser: row level security is what actually protects
# the data, and every table in this schema has it enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set only when running `next build` without a live project. It skips the
# env check so the build can be verified in CI. Never set this in production.
NEXT_PUBLIC_ALLOW_MISSING_SUPABASE=1
