# Copy to .env.local. Never commit .env.local.
#
# Both values come from Supabase → Project Settings → API. The anon key is
# safe to ship to the browser: row level security is what actually protects
# the data, and every table in this schema has it enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The address this deployment answers on, e.g. https://ayahspring.com.
# Public by design: it is printed on every certificate as the place to check the
# number, and it is never taken from a request header — a Host header is the one
# part of a request a visitor can choose, and an attacker's host on a
# downloadable PDF turns a verification page into a phishing page. Leave it unset
# and a certificate prints the path only, which is still exact for anybody who
# received the certificate from the holder.
NEXT_PUBLIC_SITE_URL=

# The secret that seals lessons saved on a device.
#
# 32 random bytes, base64: `openssl rand -base64 32`. Server-only — never
# NEXT_PUBLIC_, never in a bundle. Every saved lesson is AES-GCM encrypted with a
# key derived from this and the save's id, and the key is minted only while the
# save is live, so rotating this value makes every stored copy unreadable and
# every learner re-save once. Leave it unset and offline saving refuses rather
# than storing a lesson in the clear.
OFFLINE_VAULT_SECRET=

# Set only when running `next build` without a live project. It skips the
# env check so the build can be verified in CI. Never set this in production.
NEXT_PUBLIC_ALLOW_MISSING_SUPABASE=1

# Required by coursework confirmation, child-login creation/removal, safeguarding alerts
# and the payment webhook. Never prefix this with NEXT_PUBLIC_ —
# it bypasses every row level security policy in the schema and must not reach
# a browser bundle. Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which registered payment adapter is live is set below, under "Payment
# providers". Leave it unset until a provider is chosen (DECISIONS.md P12);
# checkout then reports that payments are not configured rather than pretending.

# ---------------------------------------------------------------------------
# Payment providers
#
# More than one provider can be live at once. A provider is offered on the
# checkout page as soon as its credentials are present — no code change and no
# redeploy, which is how a provider that is not built yet gets switched on.
# Leave a block empty and that provider is simply not offered.
#
# Every credential here is server-only. None of these may be prefixed
# NEXT_PUBLIC_: they authenticate the platform to the provider, and anything
# exposed to the browser lets a caller initiate payments as the merchant.
#
# PAYMENT_PROVIDER is optional. It pins a single provider for deployments that
# want one; with it unset, the first available provider is the default and the
# payer can choose between the rest.
# ---------------------------------------------------------------------------

# Optional: pin one provider by its id (mtn_momo, airtel_money_ke, pawapay_mpesa_ke ...)
PAYMENT_PROVIDER=

# --- Mobile money, country by country ---------------------------------------
# A mobile-money account is one operator in one country: it prompts that
# country's numbers and collects that country's currency. So each country has
# its own set of names, with the country's two letters in them:
#
#   MTN_MOMO_GH_SUBSCRIPTION_KEY=   MTN_MOMO_GH_API_USER=   MTN_MOMO_GH_API_KEY=
#   AIRTEL_KE_CLIENT_ID=            AIRTEL_KE_CLIENT_SECRET=
#
# Those default to the production hosts, the country's own header and its own
# currency. Each can be overridden with the same name and _BASE_URL,
# _TARGET_ENVIRONMENT (MTN), _CURRENCY, _CALLBACK_URL (MTN), _REFUND_PATH
# (Airtel) or the three MTN _DISBURSEMENT_ names.
#
# Countries MTN's Open API serves: UG GH CI ZM CM BJ CG SZ GN ZA LR.
# Countries Airtel Money operates in: UG KE TZ RW ZM MW CD CG GA TD NE MG SC.
# (lib/payments/markets.ts; neither list was checked against a live account.)
#
# A provider's id is the service and the country: mtn_momo_gh, airtel_money_ke.
# Its callback URL is https://your-domain/api/payments/webhook/<that id>.
#
# The names below, without a country, are one account like any other: the
# country is MTN_MOMO_COUNTRY / AIRTEL_COUNTRY (Uganda when unset), the ids are
# mtn_momo and airtel_money, and they default to the test hosts.

# --- MTN MoMo (Collections) -------------------------------------------------
# Sandbox credentials are self-provisioned at https://momodeveloper.mtn.com.
# Production base URL and X-Target-Environment are market-specific — for
# Uganda the environment is mtnuganda; confirm the host with MTN.
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
# The country this account collects in. MTN's sandbox takes only EUR: set
# MTN_MOMO_CURRENCY=EUR to try it there.
MTN_MOMO_COUNTRY=UG
# Must be publicly reachable over HTTPS. Set this to the per-provider route:
#   https://your-domain/api/payments/webhook/mtn_momo
MTN_MOMO_CALLBACK_URL=

# Refunds go out through MTN's Disbursements product, which is a separate
# subscription with its own credentials. Without these, refunding an MTN
# payment is refused rather than silently skipped.
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=

# --- Airtel Money ----------------------------------------------------------
# Sandbox is openapiuat.airtel.africa; production is openapi.airtel.africa.
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_COUNTRY=UG
# The country's own currency unless this says otherwise.
AIRTEL_CURRENCY=
# The refund path differs between markets and API versions. Confirm it in
# sandbox before going live; the default is the most widely documented shape.
AIRTEL_REFUND_PATH=/merchant/v1/payments/refund/

# --- M-Pesa, Kenya, direct (Safaricom's Daraja API, "M-Pesa Express") --------
# WRITTEN FROM PUBLIC DESCRIPTIONS OF DARAJA AND RUN AGAINST NOTHING: no
# Daraja app exists, test or live. A live one needs a paybill or till in the
# name of a registered business.
#
# All five are needed. Kenya only: M-Pesa elsewhere is another company's.
MPESA_KE_CONSUMER_KEY=
MPESA_KE_CONSUMER_SECRET=
# The paybill; or, for a till, the store number the till belongs to.
MPESA_KE_SHORTCODE=
# The passkey Safaricom issues for M-Pesa Express on that shortcode.
MPESA_KE_PASSKEY=
# This deployment's own address for Safaricom's callbacks, https, no query:
#   https://your-domain/api/payments/webhook/mpesa_ke
# Each payment is given this address with its order added under a code, and a
# callback anywhere else is ignored.
MPESA_KE_CALLBACK_URL=
# Optional: a till number. Payments are then "Buy Goods" to that till.
MPESA_KE_TILL=
# Safaricom's test host unless this says otherwise.
# Production: https://api.safaricom.co.ke
MPESA_KE_BASE_URL=https://sandbox.safaricom.co.ke

# --- pawaPay (an aggregator: many operators, one account) --------------------
# M-Pesa, Orange Money, Moov, telebirr and the rest, and MTN and Airtel in the
# countries where this platform has no account of its own, through one token.
# WRITTEN FROM pawaPay's PUBLISHED DOCUMENTATION AND RUN AGAINST ITS SANDBOX
# ONLY (deposits and their status, with test numbers). No callback, refund or
# live payment has been tried: there is no live account. Start in the sandbox.
#
# The token from the pawaPay dashboard. A sandbox token and a live one differ.
PAWAPAY_API_TOKEN=
# Sandbox unless this says otherwise. Production: https://api.pawapay.io
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# The operators pawaPay has enabled on the account, by pawaPay's own codes,
# separated by commas: MPESA_KEN, MTN_MOMO_UGA, ORANGE_SEN. Nothing is offered
# to a payer that is not listed here. The codes this platform knows are in
# lib/payments/markets.ts (PAWAPAY_BRANDS); each becomes a provider named for
# the operator and country, e.g. pawapay_mpesa_ke.
PAWAPAY_PROVIDERS=
# Optional: the note a payer may see on their handset. 4 to 22 letters, digits
# and spaces; anything else is ignored and "AyahSpring course" is sent.
PAWAPAY_CUSTOMER_MESSAGE=
# In the pawaPay dashboard, set the deposit callback URL to
#   https://your-domain/api/payments/webhook/pawapay
# and leave "only accept signed requests" off: requests are not signed.

# Cloudflare R2, chosen for media masters and delivery on 2026-10-20 (D8,
# costed at docs/decisions/media-storage-costing.md). Server-side only: the
# secret signs uploads, so it must never carry a NEXT_PUBLIC_ prefix or reach a
# browser bundle. Leave unset until the bucket and API token exist; /api/media
# then reports that storage is not configured rather than pretending.
# R2 → Account ID, and an API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional. These defaults must match what register_media_upload() derives for
# backend 'r2' (supabase/migrations/20261107000100_media_asset_writer.sql);
# /api/media refuses rather than signs when the two disagree.
# R2_MASTERS_BUCKET=ayahspring-masters
# R2_RENDITIONS_BUCKET=ayahspring-renditions

# ---------------------------------------------------------------------------
# Email delivery
#
# The outbox is built and enforced in the database; this is the one call in the
# middle. Choose a provider by setting its key — nothing else changes.
#
# Resend, because its free tier is permanent rather than a trial: 3,000 messages
# a month, 100 a day, no card. That is more mail than a platform with no learners
# can produce, and enough for the first few hundred. Past 100 in a day, sends
# fail, retry on the backoff, and dead-letter for a person to release — nothing
# is lost, but nothing is delivered either.
#
# With no key set, the dispatcher claims NOTHING. That is deliberate: claiming is
# what starts a message's attempt counter, so a run without credentials would
# burn all five attempts against a 401 and dead-letter the whole outbox in one
# pass.
#
# Before delivery can be switched on, three DNS records for the sending domain
# (DKIM, SPF, DMARC) have to exist. They are free and they are what keeps
# receipts out of a spam folder.
RESEND_API_KEY=

# The sender. Must be on the domain whose DNS records you added.
# EMAIL_FROM=no-reply@ayahspring.com
# Where a reply goes. Leave unset and replies bounce, which is worse than an
# address nobody reads.
# EMAIL_REPLY_TO=privacy@ayahspring.com

# What became of a message after Resend accepted it (delivered, bounced, marked
# as spam). Resend reports that by calling POST /api/email/webhook, signed with
# this secret. Make the webhook at Resend → Webhooks, point it at
# https://<the site>/api/email/webhook, choose the events email.delivered,
# email.delivery_delayed, email.bounced, email.complained, email.failed and
# email.suppressed, and copy its signing secret (it begins with whsec_) here.
# Needs SUPABASE_SERVICE_ROLE_KEY as well. Without it the route answers 503 and
# a late bounce is never learned of.
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# The unattended dispatcher
#
# POST /api/cron/dispatch-messages, called by a scheduler (a GitHub Action on a
# public repository, or cron-job.org — both free) with:
#   Authorization: Bearer <CRON_SECRET>
#
# The worker signs in as a staff account rather than using the service role: the
# database only lets a *privileged person* claim or settle a message, so a
# machine writer is subject to the same refusals as a human and every send is
# attributable. Create the account, give it a privileged role, and put its
# credentials here. It needs no mailbox.
CRON_SECRET=
EMAIL_WORKER_EMAIL=
EMAIL_WORKER_PASSWORD=

# ---------------------------------------------------------------------------
# The retention cleanup
#
# POST /api/cron/retention, called by the same scheduler with the same
# Authorization header. Two clocks run here and neither is optional: a support
# case goes three years after it closes, a record that a teacher was checked goes
# seven years after the later of the check and their eighteenth birthday. Both
# are promised in the privacy notice, so this is the job that keeps the promise.
#
# The worker must hold `platform_admin`: the database only lets the owner delete
# a record before it is due — or at all. It needs no mailbox. Unset means the
# route answers 503 and deletes nothing, and the same work can be done by hand at
# /admin/retention.
RETENTION_WORKER_EMAIL=
RETENTION_WORKER_PASSWORD=

# ---------------------------------------------------------------------------
# The encoder
#
# `npm run worker:transcode` — the one process that is not a web request. It
# downloads a master from R2, runs ffprobe and ffmpeg against it, and writes the
# copies a browser plays. It needs the R2 values above, the Supabase URL, and a
# *staff account* of its own, because every writer in this schema checks that a
# privileged person called it: a machine writer is subject to the same refusals
# as a human, its work is attributable, and revoking the role stops it.
#
# Create the account once, grant platform_admin at /admin/roles with a written
# reason, and put its credentials here. It needs no mailbox.
#
# These were missing from this file until the deployment runbook was written,
# which is exactly the kind of gap the runbook exists to find.
MEDIA_WORKER_EMAIL=
MEDIA_WORKER_PASSWORD=

# The Supabase URL and anon key the worker uses are the SAME two values declared
# at the top of this file. A plain Node process has no Next runtime, so
# NEXT_PUBLIC_ means nothing to it and the worker reads either name — the bare
# `SUPABASE_URL` / `SUPABASE_ANON_KEY` if you have them, the NEXT_PUBLIC_ pair
# otherwise. Copying this file and setting one pair is enough for both.
#
# (Found 2026-11-01 by running this runbook against the code: step 6.3 exported
# the NEXT_PUBLIC_ pair and the worker exited asking for SUPABASE_URL. Both are
# accepted now.)

# Optional owner-initiated quarantine scan. Local Unix socket only; run and
# maintain an isolated ClamAV daemon on the same host. Never expose this socket
# to the public. A scan does not automatically release a file or gate uploads.
COURSEWORK_CLAMAV_SOCKET=

# The Translate button (owner decision, 2026-11-24). A Google Cloud
# Translation API key (Basic, v2). Server-only: never give it a NEXT_PUBLIC_
# name, because a key in a browser bundle is a key anybody can spend. In
# Google Cloud, restrict the key to the Cloud Translation API. Without it the
# button is drawn nowhere and /api/translate answers "closed", whatever the
# `platform.translate` switch says. With it, what somebody wrote is sent to
# Google when a reader presses Translate: the text and the language wanted,
# and nothing about who wrote it or who asked.
GOOGLE_TRANSLATE_API_KEY=

# Tests only, and ignored in production: where the translation request goes
# instead of Google, so a test never needs a key that can be charged.
# TRANSLATE_TEST_ENDPOINT=
