{
  "name": "ayahspring-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AyahSpring \u2014 Islamic e-learning platform.",
  "scripts": {
    "test:db": "node supabase/tests/run.mjs",
    "check:repo": "node scripts/repo-check.mjs",
    "i18n:apply": "node --experimental-strip-types scripts/i18n-apply.ts",
    "preflight": "node --experimental-strip-types scripts/preflight.ts",
    "dev": "npm run dev --workspace @ayahspring/web",
    "worker:transcode": "node --experimental-strip-types web/src/worker/transcode-worker.ts",
    "build": "npm run build --workspace @ayahspring/web",
    "typecheck": "npm run typecheck --workspace @ayahspring/web",
    "test:web": "npm run test --workspace @ayahspring/web",
    "test": "npm run check:repo && npm run lint && npm run test:db && npm run test:web",
    "lint": "npm run lint --workspace @ayahspring/web",
    "test:child-locks:postgres": "node supabase/tests/child_login_lock_protocol.postgres.mjs",
    "test:clamav:integration": "node --experimental-strip-types scripts/clamav-integration.mjs",
    "test:discussion-locks:postgres": "node supabase/tests/discussion_lock_protocol.postgres.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "pg": "^8.16.3"
  },
  "workspaces": [
    "web"
  ]
}
